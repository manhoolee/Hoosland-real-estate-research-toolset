# Template only. The application does not load this file automatically.
# Export these variables in your shell or use a root-readable systemd
# EnvironmentFile. Never commit a populated copy.
APP_ENV=development
APP_SLOT=local
BUILD_ID=dev
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
FRONTEND_DIST=../frontend/dist
HARNESS_CORDIS_PATH=./cordis.yml
HARNESS_PROVIDER=deepseek-official
HARNESS_MODEL=deepseek-v4-flash
HARNESS_MAX_TOKENS=49152
HARNESS_RUNNER_CACHE_SIZE=4
HARNESS_SKILL_DIRS=../skills
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_API_KEY=
DSH_SEARCH_MODEL=deepseek-v4-flash
CAPABILITY_MCP_URL=http://127.0.0.1:8000/mcp
CAPABILITY_MCP_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=
ADMIN_SESSION_SECONDS=28800
# Keep false for local HTTP; set true behind HTTPS.
ADMIN_COOKIE_SECURE=false
OPERATION_LOG_ENABLED=true
OPERATION_LOG_RETENTION_DAYS=14

VISION_ANALYZE_API_BASE_URL=
VISION_ANALYZE_API_PATH=/chat/completions
VISION_ANALYZE_API_MODEL=
VISION_ANALYZE_API_KEY=
IMAGE_GENERATE_API_BASE_URL=
IMAGE_GENERATE_API_PATH=/images/generations
IMAGE_GENERATE_API_MODEL=
IMAGE_GENERATE_API_KEY=
WEB_SEARCH_API_BASE_URL=
WEB_SEARCH_API_PATH=/web-search
WEB_SEARCH_API_KEY=
DOCUMENT_EXTRACT_API_BASE_URL=
DOCUMENT_EXTRACT_API_PATH=/extract
DOCUMENT_EXTRACT_API_KEY=
DELEGATE_TEXT_API_BASE_URL=
DELEGATE_TEXT_API_PATH=/chat/completions
DELEGATE_TEXT_API_MODEL=
DELEGATE_TEXT_API_KEY=
